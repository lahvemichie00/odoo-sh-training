<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Purchase Request Sequence -->
    <record id="seq_purchase_request" model="ir.sequence">
        <field name="name">Purchase Request</field>
        <field name="code">purchase.request</field>
        <field name="prefix">PR/%(y)s%(month)s/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- RFQ Sequence -->
    <record id="seq_purchase_request_rfq" model="ir.sequence">
        <field name="name">Request for Quotation</field>
        <field name="code">purchase.request.rfq</field>
        <field name="prefix">RFQ/%(y)s%(month)s/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>