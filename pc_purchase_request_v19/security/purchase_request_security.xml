<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase.group_purchase_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('pc_approval_matrix_v19.group_approval_matrix_user'))]"/>
    </record>

    <record id="purchase.group_purchase_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('pc_approval_matrix_v19.group_approval_matrix_manager'))]"/>
    </record>

    <record id="rule_purchase_request_company" model="ir.rule">
        <field name="name">Purchase requests by company</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="rule_purchase_request_line_company" model="ir.rule">
        <field name="name">Purchase request lines by company</field>
        <field name="model_id" ref="model_purchase_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
</odoo>
