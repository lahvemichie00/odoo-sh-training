<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_approval_form" model="ir.ui.view">

        <field name="name">purchase.order.approval.form</field>

        <field name="model">purchase.order</field>

        <field name="inherit_id" ref="purchase.purchase_order_form"/>


        <field name="arch" type="xml">


            <!-- ===================================================== -->
            <!-- SMART BUTTONS                                         -->
            <!-- ===================================================== -->

            <xpath expr="//div[@name='button_box']" position="inside">

                <!-- PURCHASE REQUEST -->

                <button name="action_open_purchase_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="purchase_request_count == 0">

                    <field name="purchase_request_count"
                           widget="statinfo"
                           string="Purchase Requests"/>

                </button>

                <!-- PURCHASE ORDER -->

                <button name="action_open_purchase_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="po_count == 0">

                    <field name="po_count"
                           widget="statinfo"
                           string="Purchase Orders"/>

                </button>

                <!-- SOURCE RFQ -->

                <button name="action_open_source_rfq"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not source_rfq_id or purchase_document_type != 'po'">

                    <div class="o_stat_info">

                        <span class="o_stat_text">
                           Source RFQ
                        </span>

                    </div>

                </button>


                <!-- RECEIPTS -->

                <button name="action_view_receipt"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="receipt_count == 0
                                  or purchase_document_type != 'po'">


                   <field name="receipt_count"
                          widget="statinfo"
                          string="Receipts"/>

                </button>


                <!-- BILLS -->

                <button name="action_view_invoice"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="invoice_count == 0
                                  or purchase_document_type != 'po'">

                    <field name="invoice_count"
                           widget="statinfo"
                           string="Bills"/>

                </button>

            </xpath>

            <!-- ===================================================== -->
            <!-- STATUSBAR + APPROVAL BUTTONS                          -->
            <!-- ===================================================== -->

            <!-- Replace Odoo Purchase Statusbar -->

            <xpath expr="//field[@name='state']" position="replace">

                <field name="approval_state"
                       widget="statusbar"
                       statusbar_visible="draft,waiting_approval,approved"/>

            </xpath>

            <!-- Hide Default Purchase Buttons -->

            <xpath expr="//button[@name='action_rfq_send']" position="attributes"
                   optional="show">

                <attribute name="invisible">1</attribute>

            </xpath>

            <xpath expr="//button[@name='button_confirm']" position="attributes">

                <attribute name="invisible">1</attribute>

            </xpath>


            <xpath expr="//button[@name='button_cancel']" position="attributes"
                   optional="show">

                <attribute name="invisible">1</attribute>

            </xpath>


            <!-- HIDE LOCK -->

            <xpath expr="//button[@name='button_lock']" position="attributes"
                   optional="show">

                <attribute name="invisible">
                    approval_state != 'approved'
                </attribute>

            </xpath>

            <!-- Approval Buttons -->

            <xpath expr="//header" position="inside">


                <button name="action_submit_for_approval"
                        type="object"
                        string="SUBMIT FOR APPROVAL"
                        class="oe_highlight"
                        invisible="approval_state != 'draft'"/>

                <button name="action_approve"
                        type="object"
                        string="APPROVE"
                        class="oe_highlight"
                        invisible="approval_state != 'waiting_approval'
                                   or not approval_can_current_user"/>


                <button name="action_open_approval_reject_wizard"
                        type="object"
                        string="REJECT"
                        invisible="approval_state != 'waiting_approval'
                                  or not approval_can_current_user"/>


                <!-- CONFIRM RFQ -->

               <button name="button_confirm"
                       type="object"
                       string="CONFIRM RFQ"
                       class="oe_highlight"
                       invisible="approval_state != 'approved'
                                 or purchase_document_type != 'rfq'"/>


                <button name="action_add_foc_line"
                        type="object"
                        string="ADD FOC"
                        class="oe_highlight"
                        invisible="approval_state != 'approved'
                                  or purchase_document_type != 'po'"/>


            </xpath>

            <!-- ===================================================== -->
            <!-- APPROVAL INFORMATION                                  -->
            <!-- ===================================================== -->

            <xpath expr="//notebook" position="inside">

                <page string="Approvals">

                    <group>

                        <group>

                            <field name="purchase_document_type"
                                   string="Document Type"
                                   readonly="1"/>

                            <field name="approval_stage"
                                   string="Approval Stage"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="approval_state"
                                   string="Approval Status"
                                   readonly="1"/>

                        </group>
                    </group>
                </page>

            </xpath>

            <!-- ===================================================== -->
            <!-- TECHNICAL FIELDS                                      -->
            <!-- ===================================================== -->

            <xpath expr="//sheet" position="inside">

                <!-- Approval Permission -->

                <field name="approval_can_current_user"
                       invisible="1"/>

                <field name="approval_is_approved"
                       invisible="1"/>

                <!-- Purchase Request Smart Button -->

                <field name="purchase_request_ids"
                       invisible="1"/>

                <field name="purchase_request_count"
                       invisible="1"/>

                <!-- RFQ / PO Smart Button -->

                <field name="rfq_count"
                       invisible="1"/>

                <field name="po_count"
                       invisible="1"/>


                <!-- Source RFQ Link -->

                <field name="source_rfq_id"
                       invisible="1"/>

            </xpath>

            <!-- ===================================================== -->
            <!-- PURCHASE ORDER LINE FOC                               -->
            <!-- ===================================================== -->

            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']"
                   position="after">

                <field name="is_foc"
                       string="FOC"/>

            </xpath>

        </field>
    </record>

</odoo>