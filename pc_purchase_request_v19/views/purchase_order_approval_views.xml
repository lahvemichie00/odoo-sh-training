<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_approval_form" model="ir.ui.view">

        <field name="name">purchase.order.approval.form</field>

        <field name="model">purchase.order</field>

        <field name="inherit_id" ref="purchase.purchase_order_form"/>


        <field name="arch" type="xml">


            <!-- ===================================================== -->
            <!-- SMART BUTTONS                                         -->
            <!-- ===================================================== -->

            <xpath expr="//div[@name='button_box']" position="inside">


                <!-- ================================================= -->
                <!-- PURCHASE REQUEST SMART BUTTON -->
                <!-- ================================================= -->

                <button name="action_open_purchase_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="purchase_request_count == 0">

                    <field name="purchase_request_count"
                           widget="statinfo"
                           string="Purchase Requests"/>

                </button>



                <!-- ================================================= -->
                <!-- SOURCE RFQ SMART BUTTON -->
                <!-- ================================================= -->
                
                <!--
                <button name="action_open_source_rfq"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list-alt"
                        invisible="source_rfq_id == False">

                    <field name="source_rfq_id"
                           widget="statinfo"
                           string="Source RFQ"/>

                </button>
                -->

                <!-- ================================================= -->
                <!-- CONVERTED PO SMART BUTTON -->
                <!-- ================================================= -->
                <!--
                <button name="action_open_converted_purchase_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="converted_po_count == 0">

                    <field name="converted_po_count"
                           widget="statinfo"
                           string="Purchase Orders"/>

                </button> 
                -->
            </xpath>

            <!-- ===================================================== -->
            <!-- APPROVAL BUTTONS                                      -->
            <!-- ===================================================== -->

            <xpath expr="//header" position="inside">

                <button name="action_submit_for_approval"
                        type="object"
                        string="SUBMIT FOR APPROVAL"
                        class="oe_highlight"
                        invisible="approval_state != 'draft'"/>

                <button name="action_approve"
                        type="object"
                        string="APPROVE"
                        class="oe_highlight"
                        invisible="approval_state != 'waiting_approval'
                                  or not approval_can_current_user"/>

                <button name="action_open_approval_reject_wizard"
                        type="object"
                        string="REJECT"
                        invisible="approval_state != 'waiting_approval'
                                   or not approval_can_current_user"/>

                <!--
                <button name="action_convert_to_po"
                        type="object"
                        string="CONVERT TO PO"
                        class="oe_highlight"
                        invisible="approval_stage != 'rfq'
                                   or approval_state != 'approved'
                                   or converted_po_count > 0"/>
                -->

            </xpath>

            <!-- ===================================================== -->
            <!-- RFQ REFERENCE                                         -->
            <!-- ===================================================== -->
            <!--
            <xpath expr="//field[@name='partner_id']" position="after">


                <field name="rfq_number"
                       string="RFQ Reference"
                       readonly="1"
                       invisible="approval_stage != 'rfq'"/>


            </xpath>
            -->




            <!-- ===================================================== -->
            <!-- APPROVAL INFORMATION                                  -->
            <!-- ===================================================== -->


            <xpath expr="//notebook" position="before">


                <group string="Approval">


                    <group>

                        <field name="approval_stage"
                               string="Approval Stage"
                               readonly="1"/>

                    </group>


                    <group>

                        <field name="approval_state"
                               string="Approval Status"
                               readonly="1"/>

                    </group>


                </group>


            </xpath>





            <!-- ===================================================== -->
            <!-- TECHNICAL FIELDS                                      -->
            <!-- ===================================================== -->


            <xpath expr="//sheet" position="inside">


                <field name="approval_can_current_user"
                       invisible="1"/>



                <field name="approval_is_approved"
                       invisible="1"/>



                <field name="purchase_request_ids"
                       invisible="1"/>



                <field name="purchase_request_count"
                       invisible="1"/>


                <!--
                <field name="source_rfq_id"
                       invisible="1"/>



                <field name="converted_po_ids"
                       invisible="1"/>



                <field name="converted_po_count"
                       invisible="1"/>
                -->

            </xpath>



        </field>

    </record>


</odoo>