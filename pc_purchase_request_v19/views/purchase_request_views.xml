<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_list" model="ir.ui.view">
        <field name="name">purchase.request.list</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'waiting_approval'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'reject'">
                <field name="name"/>
                <field name="date_order"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="user_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'waiting_approval'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'reject'"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button name="action_confirm" type="object" string="CONFIRM"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="APPROVE"
                            class="oe_highlight"
                            invisible="state != 'waiting_approval' or not approval_can_current_user"/>
                    <button name="action_open_approval_reject_wizard" type="object" string="REJECT"
                            invisible="state != 'waiting_approval' or not approval_can_current_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,waiting_approval,approved"/>
                </header>
                <sheet>
                    <field name="approval_can_current_user" invisible="1"/>
                    <field name="approval_is_approved" invisible="1"/>
                    <field name="is_locked" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="user_id" readonly="is_locked"/>
                            <field name="employee_id" readonly="is_locked" options="{'no_create': True}" invisible="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="group_category_id" readonly="is_locked"/>
                        </group>
                        <group>
                            <field name="date_order" string="Requestion Date" readonly="is_locked"/>
                            <field name="create_date" string="Created on" readonly="1"/>
                            <field name="company_id" readonly="is_locked"/>
                            <field name="is_asset" readonly="is_locked" optional="hide"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Purchase Request Line">
                            <field name="line_ids" readonly="is_locked">
                                <list editable="bottom">
                                    <field name="default_code"/>
                                    <field name="product_id"/>
                                    <field name="desc"/>
                                    <field name="request_eta"/>
                                    <field name="qty"/>
                                    <field name="qty_released" readonly="1"/>
                                    <field name="product_uom_id"/>
                                    <field name="stock_on_hand" readonly="1"/>
                                    <field name="incoming_qty" readonly="1"/>
                                    <field name="purchase_message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Information">
                            <group>
                                <group>
                                    <field name="confirmed_by"/>
                                    <field name="manager_department"/>
                                    <field name="approved_by"/>
                                    <field name="rejected_by"/>
                                    <field name="reject_message"/>
                                </group>
                                <group>
                                    <field name="date_confirmed"/>
                                    <field name="date_approval_department"/>
                                    <field name="date_approved"/>
                                    <field name="date_rejected"/>
                                </group>
                            </group>
                        </page>
                        <page string="Approvals">
                            <field name="approval_document_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="res_model"/>
                                    <field name="res_name"/>
                                    <field name="matrix_id"/>
                                    <field name="approver_seq"/>
                                    <field name="approver_ids" widget="many2many_tags"/>
                                    <field name="minimum_approved"/>
                                    <field name="approved_by_ids" widget="many2many_tags"/>
                                    <field name="rejected_by_ids" widget="many2many_tags"/>
                                    <field name="is_approved"/>
                                </list>
                            </field>
                            <group>
                                <field name="approval_is_approved" string="Approved" readonly="1"/>
                                <button name="action_fetch_matrix" type="object" string="FETCH MATRIX"
                                        groups="purchase.group_purchase_manager"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_purchase_request_search" model="ir.ui.view">
        <field name="name">purchase.request.search</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="department_id"/>
                <field name="group_category_id"/>
                <filter string="My Requests" name="my_requests" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Waiting Approval" name="waiting" domain="[('state', '=', 'waiting_approval')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Reject" name="reject" domain="[('state', '=', 'reject')]"/>
                <separator/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_request" model="ir.actions.act_window">
        <field name="name">Purchase Request</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_purchase_request_line_list" model="ir.ui.view">
        <field name="name">purchase.request.line.list</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="state == 'cancel'">
                <field name="purchase_request_id"/>
                <field name="request_eta"/>
                <field name="default_code"/>
                <field name="product_id"/>
                <field name="desc"/>
                <field name="qty"/>
                <field name="product_uom_id"/>
                <field name="state" string="State PR Line"/>
                <field name="origin"/>
                <field name="pr_line_state" string="State PR"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_request_line_search" model="ir.ui.view">
        <field name="name">purchase.request.line.search</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="purchase_request_id"/>
                <field name="default_code"/>
                <field name="product_id"/>
                <filter string="To Do" name="todo"
                        domain="[('pr_line_state', '=', 'approved'), ('state', '=', 'draft')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Purchase Request" name="group_request"
                        context="{'group_by': 'purchase_request_id'}"/>
                <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_request_line" model="ir.actions.act_window">
        <field name="name">Purchase Request Line</field>
        <field name="res_model">purchase.request.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_todo': 1}</field>
    </record>

    <record id="server_action_purchase_request_create_rfq" model="ir.actions.server">
        <field name="name">Create RFQ</field>
        <field name="model_id" ref="model_purchase_request_line"/>
        <field name="binding_model_id" ref="model_purchase_request_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.with_context(pr_confirm_order=False).action_open_create_order_wizard()</field>
    </record>

    <record id="server_action_purchase_request_create_po" model="ir.actions.server">
        <field name="name">Create PO</field>
        <field name="model_id" ref="model_purchase_request_line"/>
        <field name="binding_model_id" ref="model_purchase_request_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.with_context(pr_confirm_order=True).action_open_create_order_wizard()</field>
    </record>

    <record id="server_action_purchase_request_cancel" model="ir.actions.server">
        <field name="name">Cancel</field>
        <field name="model_id" ref="model_purchase_request_line"/>
        <field name="binding_model_id" ref="model_purchase_request_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_cancel_lines()</field>
    </record>

    <record id="view_product_group_category_list" model="ir.ui.view">
        <field name="name">product.group.category.list</field>
        <field name="model">product.group.category</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="name"/><field name="active" optional="hide"/></list>
        </field>
    </record>

    <record id="action_product_group_category" model="ir.actions.act_window">
        <field name="name">Group Categories</field>
        <field name="res_model">product.group.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
