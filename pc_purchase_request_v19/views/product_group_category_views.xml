<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Group Category List View -->
    <record id="view_product_group_category_list" model="ir.ui.view">
        <field name="name">product.group.category.list</field>
        <field name="model">product.group.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- Group Category Form View -->
    <record id="view_product_group_category_form" model="ir.ui.view">
        <field name="name">product.group.category.form</field>
        <field name="model">product.group.category</field>
        <field name="arch" type="xml">
            <form string="Group Category">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Group Category Action -->
    <record id="action_product_group_category" model="ir.actions.act_window">
        <field name="name">Group Categories</field>
        <field name="res_model">product.group.category</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>