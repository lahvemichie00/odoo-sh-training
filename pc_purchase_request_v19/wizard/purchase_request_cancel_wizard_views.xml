<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_request_cancel_wizard_form" model="ir.ui.view">
        <field name="name">purchase.request.cancel.wizard.form</field>
        <field name="model">purchase.request.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Purchase Request">

                <group>
                    <field name="purchase_request_id"/>
                    <field name="cancellation_reason"
                           placeholder="Enter cancellation reason..."/>
                </group>

                <footer>
                    <button name="action_cancel"
                            type="object"
                            string="CANCEL"
                            class="btn-primary"/>

                    <button string="DISCARD"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>