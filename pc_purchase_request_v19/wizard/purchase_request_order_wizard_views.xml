<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_order_wizard_form" model="ir.ui.view">
        <field name="name">purchase.request.line.make.purchase.order.form</field>
        <field name="model">purchase.request.line.make.purchase.order</field>
        <field name="arch" type="xml">
            <form string="Create RFQ / Purchase Order">
                <group>
                    <group>
                        <field name="supplier_id"/>
                        <field name="purchase_order_id"/>
                        <field name="picking_type_id"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="currency_id"/>
                        <field name="group_category_id"/>
                        <field name="confirm_order"/>
                    </group>
                </group>
                <field name="item_ids">
                    <list editable="bottom">
                        <field name="line_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="name"/>
                        <field name="product_qty"/>
                        <field name="product_uom_id"/>
                        <field name="price_unit"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_order" type="object" string="Create"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
