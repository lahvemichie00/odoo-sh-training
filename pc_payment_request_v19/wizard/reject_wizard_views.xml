<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pc_payment_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">pc.payment.request.reject.wizard.form</field>
        <field name="model">pc.payment.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Payment Request">
                <group>
                    <field name="request_id"/>
                    <field name="reason" placeholder="Explain why this request is rejected..."/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

