<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_payment_request_user" model="res.groups">
        <field name="name">Payment Request User</field>
        <field name="implied_ids" eval="[(4, ref('pc_approval_matrix_v19.group_approval_matrix_user'))]"/>
    </record>

    <record id="group_payment_request_approver" model="res.groups">
        <field name="name">Payment Request Approver</field>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <record id="group_payment_request_manager" model="res.groups">
        <field name="name">Payment Request Manager</field>
        <field name="implied_ids" eval="[
            (4, ref('group_payment_request_approver')),
            (4, ref('pc_approval_matrix_v19.group_approval_matrix_manager'))
        ]"/>
    </record>

    <record id="rule_payment_request_user" model="ir.rule">
        <field name="name">Payment requests: requester or approver</field>
        <field name="model_id" ref="model_pc_payment_request"/>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
        <field name="domain_force">['|', ('requester_id', '=', user.id), ('approval_ids.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_payment_request_manager" model="ir.rule">
        <field name="name">Payment requests: managers see all</field>
        <field name="model_id" ref="model_pc_payment_request"/>
        <field name="groups" eval="[(4, ref('group_payment_request_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_payment_request_line_user" model="ir.rule">
        <field name="name">Payment request lines: requester or approver</field>
        <field name="model_id" ref="model_pc_payment_request_line"/>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
        <field name="domain_force">['|', ('request_id.requester_id', '=', user.id), ('request_id.approval_ids.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_payment_request_line_manager" model="ir.rule">
        <field name="name">Payment request lines: managers see all</field>
        <field name="model_id" ref="model_pc_payment_request_line"/>
        <field name="groups" eval="[(4, ref('group_payment_request_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_payment_request_approval_user" model="ir.rule">
        <field name="name">Payment approvals: requester or approver</field>
        <field name="model_id" ref="model_pc_payment_request_approval"/>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
        <field name="domain_force">['|', ('request_id.requester_id', '=', user.id), ('request_id.approval_ids.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_payment_request_approval_manager" model="ir.rule">
        <field name="name">Payment approvals: managers see all</field>
        <field name="model_id" ref="model_pc_payment_request_approval"/>
        <field name="groups" eval="[(4, ref('group_payment_request_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>

