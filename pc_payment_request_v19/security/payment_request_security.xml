<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_payment_request" model="ir.module.category">
        <field name="name">Payment Request</field>
        <field name="sequence">36</field>
    </record>

    <record id="groups_privilege_payment_request" model="res.groups.privilege">
        <field name="name">Payment Request</field>
        <field name="category_id" ref="module_category_payment_request"/>
    </record>

    <record id="group_payment_request_user" model="res.groups">
        <field name="name">Payment Request User</field>
        <field name="privilege_id" ref="groups_privilege_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('pc_approval_matrix_v19.group_approval_matrix_user'))]"/>
    </record>

    <record id="group_payment_request_approver" model="res.groups">
        <field name="name">Payment Request Approver</field>
        <field name="privilege_id" ref="groups_privilege_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <record id="group_payment_request_manager" model="res.groups">
        <field name="name">Payment Request Manager</field>
        <field name="privilege_id" ref="groups_privilege_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_approver')), (4, ref('pc_approval_matrix_v19.group_approval_matrix_manager'))]"/>
    </record>

    <record id="rule_payment_request_company" model="ir.rule">
        <field name="name">Payment requests by company</field>
        <field name="model_id" ref="model_payment_request_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <record id="rule_payment_request_line_company" model="ir.rule">
        <field name="name">Payment request lines by company</field>
        <field name="model_id" ref="model_payment_request_order_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>
</odoo>
