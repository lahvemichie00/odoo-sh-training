<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pc_payment_request_list" model="ir.ui.view">
        <field name="name">pc.payment.request.list</field>
        <field name="model">pc.payment.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'waiting_approval'"
                  decoration-success="state in ('approved', 'paid')"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="required_date"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="department_id"/>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="approval_progress" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'waiting_approval'"
                       decoration-success="state in ('approved', 'paid')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_pc_payment_request_form" model="ir.ui.view">
        <field name="name">pc.payment.request.form</field>
        <field name="model">pc.payment.request</field>
        <field name="arch" type="xml">
            <form string="Payment Request">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight"
                            invisible="state not in ['draft', 'rejected']"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight"
                            invisible="state != 'waiting_approval' or not can_current_user_approve"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            invisible="state != 'waiting_approval' or not can_current_user_approve"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid"
                            class="oe_highlight"
                            groups="pc_payment_request_v19.group_payment_request_manager"
                            invisible="state != 'approved'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ['rejected', 'cancelled']"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ['draft', 'waiting_approval', 'rejected']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,waiting_approval,approved,paid,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_payment" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="not payment_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Payment</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger"
                            invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success"
                            invisible="state != 'paid'"/>

                    <field name="can_current_user_approve" invisible="1"/>
                    <field name="is_locked" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="requester_id" readonly="is_locked"/>
                            <field name="department_id" readonly="is_locked"
                                   options="{'no_create': True}"/>
                            <field name="partner_id" readonly="is_locked"/>
                            <field name="company_id" readonly="is_locked"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="required_date" readonly="is_locked"/>
                            <field name="currency_id" readonly="is_locked"/>
                            <field name="payment_method" readonly="is_locked"/>
                            <field name="journal_id" readonly="is_locked"/>
                            <field name="is_payment_other" readonly="is_locked"/>
                        </group>
                    </group>

                    <group>
                        <field name="payment_details" readonly="is_locked"
                               placeholder="Purpose, invoice references, and payment instructions..."/>
                    </group>

                    <notebook>
                        <page string="Payment Lines">
                            <field name="line_ids" readonly="is_locked">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="partner_bank_id"
                                           domain="[('partner_id', '=', partner_id)]"
                                           optional="show"/>
                                    <field name="account_id" optional="show"/>
                                    <field name="analytic_account_id" optional="hide"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total" readonly="1"/>
                                <field name="amount_currency" readonly="1"/>
                            </group>
                        </page>

                        <page string="Approvals">
                            <group>
                                <field name="matrix_id"/>
                                <field name="approval_progress"/>
                                <field name="current_approval_sequence"
                                       invisible="state != 'waiting_approval'"/>
                            </group>
                            <field name="approval_ids" readonly="1">
                                <list create="0" delete="0" default_order="sequence,id"
                                      decoration-success="state == 'approved'"
                                      decoration-danger="state == 'rejected'"
                                      decoration-muted="state in ('skipped', 'cancelled')">
                                    <field name="sequence"/>
                                    <field name="stage_name"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="state" widget="badge"/>
                                    <field name="decision_date"/>
                                    <field name="comment" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Audit">
                            <group>
                                <group>
                                    <field name="submitted_by_id"/>
                                    <field name="date_submitted"/>
                                    <field name="approved_by_id"/>
                                    <field name="date_approved"/>
                                </group>
                                <group>
                                    <field name="rejected_by_id"/>
                                    <field name="date_rejected"/>
                                    <field name="reject_reason"/>
                                    <field name="payment_id"
                                           groups="pc_payment_request_v19.group_payment_request_manager"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pc_payment_request_search" model="ir.ui.view">
        <field name="name">pc.payment.request.search</field>
        <field name="model">pc.payment.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="partner_id"/>
                <filter string="My Requests" name="my_requests"
                        domain="[('requester_id', '=', uid)]"/>
                <filter string="Waiting My Approval" name="my_approvals"
                        domain="[('state', '=', 'waiting_approval'), ('approval_ids.user_id', '=', uid), ('approval_ids.state', '=', 'pending')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Waiting Approval" name="waiting"
                        domain="[('state', '=', 'waiting_approval')]"/>
                <filter string="Approved" name="approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Rejected" name="rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Requester" name="group_requester"
                            context="{'group_by': 'requester_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pc_payment_request" model="ir.actions.act_window">
        <field name="name">Payment Requests</field>
        <field name="res_model">pc.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first payment request</p>
            <p>Submit payment requests for sequential department and amount-based approval.</p>
        </field>
    </record>

    <record id="action_pc_payment_request_to_approve" model="ir.actions.act_window">
        <field name="name">Requests to Approve</field>
        <field name="res_model">pc.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'waiting_approval'), ('approval_ids.user_id', '=', uid), ('approval_ids.state', '=', 'pending')]</field>
    </record>
</odoo>

