<odoo>
<record id="seq_accounting" model="ir.sequence">
<field name="name">Accounting</field>
<field name="code">accounting.order</field>
<field name="prefix">ACC/%(y)s%(month)s/</field>
<field name="padding">3</field>
<field name="company_id" eval="False"/>
</record>
<record id="payment_mode_bank" model="account.payment.mode">
<field name="name">BANK</field>
</record>
<record id="payment_mode_cash" model="account.payment.mode">
<field name="name">CASH</field>
</record>
<record id="payment_mode_credit_card" model="account.payment.mode">
<field name="name">CREDIT CARD</field>
</record>
<record id="payment_mode_fpx" model="account.payment.mode">
<field name="name">FPX</field>
</record>
</odoo>