<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_batch_payment" model="ir.module.category">
        <field name="name">Batch Payment Approval</field>
        <field name="sequence">36</field>
    </record>

    <record id="groups_privilege_batch_payment" model="res.groups.privilege">
        <field name="name">Batch Payment Approval</field>
        <field name="category_id" ref="module_category_batch_payment"/>
    </record>

    <record id="group_batch_payment_user" model="res.groups">
        <field name="name">Batch Payment User</field>
        <field name="privilege_id" ref="groups_privilege_batch_payment"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('pc_approval_matrix_v19.group_approval_matrix_user'))]"/>
    </record>

    <record id="group_batch_payment_approver" model="res.groups">
        <field name="name">Batch Payment Approver</field>
        <field name="privilege_id" ref="groups_privilege_batch_payment"/>
        <field name="implied_ids" eval="[(4, ref('group_batch_payment_user'))]"/>
    </record>

    <record id="group_batch_payment_manager" model="res.groups">
        <field name="name">Batch Payment Manager</field>
        <field name="privilege_id" ref="groups_privilege_batch_payment"/>
        <field name="implied_ids" eval="[(4, ref('group_batch_payment_approver')), (4, ref('pc_approval_matrix_v19.group_approval_matrix_manager'))]"/>
    </record>

    <record id="rule_batch_payment_company" model="ir.rule">
        <field name="name">Batch payments by company</field>
        <field name="model_id" ref="account_batch_payment.model_account_batch_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_batch_payment_user'))]"/>
    </record>
</odoo>