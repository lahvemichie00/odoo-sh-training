<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_matrix_reject_wizard_form" model="ir.ui.view">
        <field name="name">approval.matrix.reject.wizard.form</field>
        <field name="model">approval.matrix.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Document">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="reason_id" options="{'no_create': True}"/>
                    <field name="reason" placeholder="Reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
