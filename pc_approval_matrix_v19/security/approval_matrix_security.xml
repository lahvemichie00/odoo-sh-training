<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_approval_matrix_user" model="res.groups">
        <field name="name">Approval Matrix User</field>
    </record>

    <record id="group_approval_matrix_manager" model="res.groups">
        <field name="name">Approval Matrix Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_approval_matrix_user'))]"/>
    </record>

    <record id="rule_approval_matrix_company" model="ir.rule">
        <field name="name">Approval matrices by company</field>
        <field name="model_id" ref="model_pc_approval_matrix"/>
        <field name="groups" eval="[(4, ref('group_approval_matrix_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_approval_matrix_stage_company" model="ir.rule">
        <field name="name">Approval matrix stages by company</field>
        <field name="model_id" ref="model_pc_approval_matrix_stage"/>
        <field name="groups" eval="[(4, ref('group_approval_matrix_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

