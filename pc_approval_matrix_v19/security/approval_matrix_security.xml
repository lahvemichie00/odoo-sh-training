<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_approval_matrix" model="ir.module.category">
        <field name="name">Approval Matrix</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_approval_matrix_user" model="res.groups">
        <field name="name">Approval Matrix User</field>
        <field name="category_id" ref="module_category_approval_matrix"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_approval_matrix_manager" model="res.groups">
        <field name="name">Approval Matrix Manager</field>
        <field name="category_id" ref="module_category_approval_matrix"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_matrix_user'))]"/>
    </record>

    <record id="rule_approval_matrix_company" model="ir.rule">
        <field name="name">Approval matrices by company</field>
        <field name="model_id" ref="model_approval_matrix"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_approval_matrix_user'))]"/>
    </record>

    <record id="rule_approval_document_company" model="ir.rule">
        <field name="name">Document approvals by matrix company</field>
        <field name="model_id" ref="model_approval_matrix_document_approval"/>
        <field name="domain_force">[('matrix_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_approval_matrix_user'))]"/>
    </record>
</odoo>
