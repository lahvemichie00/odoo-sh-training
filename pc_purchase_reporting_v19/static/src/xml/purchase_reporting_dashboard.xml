<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

<t t-name="pc_purchase_reporting_v19.PurchaseReportingDashboard">

    <div class="o_purchase_reporting_dashboard p-4">


        <h1 class="mb-4">
            Purchase Analysis
        </h1>



        <!-- KPI SECTION -->

        <div class="row mb-4">


            <!-- Total Purchased -->

            <div class="col-md-3">

                <div class="card shadow-sm p-3 border-start border-primary border-4">

                    <h5>
                        💰 Total Purchased
                    </h5>

                    <h2>
                        <t t-esc="formatCurrency(state.total_amount)"/>
                    </h2>

                </div>

            </div>





            <!-- Untaxed Total -->

            <div class="col-md-3">

                <div class="card shadow-sm p-3 border-start border-success border-4">

                    <h5>
                        📑 Untaxed Total
                    </h5>

                    <h2>
                        <t t-esc="formatCurrency(state.untaxed_amount)"/>
                    </h2>

                </div>

            </div>





            <!-- Orders -->

            <div class="col-md-3">

                <div class="card shadow-sm p-3 border-start border-warning border-4">

                    <h5>
                        🛒 Orders
                    </h5>

                    <h2>
                        <t t-esc="state.order_count"/>
                    </h2>

                </div>

            </div>





            <!-- Average Order -->

            <div class="col-md-3">

                <div class="card shadow-sm p-3 border-start border-info border-4">

                    <h5>
                        📊 Average Order
                    </h5>

                    <h2>
                        <t t-esc="formatCurrency(state.average_order)"/>
                    </h2>

                </div>

            </div>


        </div>







        <!-- PURCHASE TREND CHART -->


        <div class="card shadow-sm mb-4">


            <div class="card-body">


                <h3>
                    📈 Purchase Trend
                </h3>


                <p>
                    Purchase amount trend by period.
                </p>


                <div class="p-4">


                    <PurchaseChart
                        labels="state.chart_labels"
                        values="state.chart_values"
                    />


                </div>


            </div>


        </div>








        <!-- PURCHASE BY VENDOR CHART -->


        <div class="card shadow-sm mb-4">


            <div class="card-body">


                <h3>
                    🏢 Purchase by Vendor
                </h3>


                <p>
                    Purchase amount analysis by vendor.
                </p>


                <div class="p-4">


                    <PurchaseVendorChart
                        labels="state.vendor_labels"
                        values="state.vendor_values"
                    />


                </div>


            </div>


        </div>








        <!-- PURCHASE BY CATEGORY CHART -->


        <div class="card shadow-sm mb-4">


            <div class="card-body">


                <h3>
                    📦 Purchase by Category
                </h3>


                <p>
                    Purchase amount analysis by product category.
                </p>


                <div class="p-4">


                    <PurchaseCategoryChart
                        labels="state.category_labels"
                        values="state.category_values"
                    />


                </div>


            </div>


        </div>








        <!-- Purchase Analysis -->


        <div class="card shadow-sm mb-4">


            <div class="card-body">


                <h3>
                    📊 Purchase Analysis
                </h3>


                <p>
                    Analyse purchase performance using Pivot, Graph and List view.
                </p>


                <button
                    class="btn btn-primary"
                    t-on-click="openPurchaseAnalysis">

                    Open Analysis

                </button>


            </div>


        </div>








        <!-- Purchase Order Period -->


        <div class="card shadow-sm mb-4">


            <div class="card-body">


                <h3>
                    📄 Purchase Order Period
                </h3>


                <p>
                    Generate Purchase Order report by period.
                </p>


                <button
                    class="btn btn-primary"
                    t-on-click="openPurchaseOrderPeriod">

                    Open Purchase Order Period

                </button>


            </div>


        </div>








        <!-- Incoming Order Period -->


        <div class="card shadow-sm">


            <div class="card-body">


                <h3>
                    📦 Incoming Order Period
                </h3>


                <p>
                    Generate Incoming Order report by period.
                </p>


                <button
                    class="btn btn-primary"
                    t-on-click="openIncomingOrderPeriod">

                    Open Incoming Order Period

                </button>


            </div>


        </div>



    </div>


</t>


</templates>