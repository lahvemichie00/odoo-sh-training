<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

<t t-name="pc_purchase_reporting_v19.PurchaseReportingDashboard">

    <div class="o_purchase_reporting_dashboard p-4">

        <h2>
            Purchase Analysis
        </h2>


        <div class="row mt-4">


            <div class="col-md-4">
                <div class="card p-4 shadow-sm">

                    <h3>
                        📊 Purchase Analysis
                    </h3>

                    <p>
                        Pivot / Graph / List Analysis
                    </p>

                    <button
                        class="btn btn-primary"
                        t-on-click="openPurchaseAnalysis">
                        Open Analysis
                    </button>

                </div>
            </div>



            <div class="col-md-4">

                <div class="card p-4 shadow-sm">

                    <h3>
                        📄 Purchase Order Period
                    </h3>

                    <p>
                        Generate Purchase Order Report
                    </p>

                    <button
                        class="btn btn-primary"
                        t-on-click="openPurchaseOrderPeriod">
                        Open
                    </button>

                </div>

            </div>



            <div class="col-md-4">

                <div class="card p-4 shadow-sm">

                    <h3>
                        📦 Incoming Order Period
                    </h3>

                    <p>
                        Generate Incoming Report
                    </p>

                    <button
                        class="btn btn-primary"
                        t-on-click="openIncomingOrderPeriod">
                        Open
                    </button>

                </div>

            </div>


        </div>

    </div>

</t>

</templates>