<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

<t t-name="pc_purchase_reporting_v19.PurchaseReportingDashboard">

    <div class="o_purchase_reporting_dashboard p-4">


        <h1 class="mb-4">
            Purchase Analysis
        </h1>



        <!-- KPI SECTION -->

        <div class="row mb-4">


            <div class="col-md-3">

                <div class="card shadow-sm p-3">

                    <h5>
                        Total Purchased
                    </h5>

                    <h2>
                        <t t-esc="state.total_amount"/>
                    </h2>

                </div>

            </div>



            <div class="col-md-3">

                <div class="card shadow-sm p-3">

                    <h5>
                        Untaxed Total
                    </h5>

                    <h2>
                        <t t-esc="state.untaxed_amount"/>
                    </h2>

                </div>

            </div>



            <div class="col-md-3">

                <div class="card shadow-sm p-3">

                    <h5>
                        Orders
                    </h5>

                    <h2>
                        <t t-esc="state.order_count"/>
                    </h2>

                </div>

            </div>



            <div class="col-md-3">

                <div class="card shadow-sm p-3">

                    <h5>
                        Average Order
                    </h5>

                    <h2>
                        <t t-esc="state.average_order"/>
                    </h2>

                </div>

            </div>


        </div>



        <!-- Purchase Analysis -->

        <div class="card shadow-sm mb-4">


            <div class="card-body">


                <h3>
                    📊 Purchase Analysis
                </h3>


                <p>
                    Analyse purchase performance using Pivot, Graph and List view.
                </p>


                <button
                    class="btn btn-primary"
                    t-on-click="openPurchaseAnalysis">

                    Open Analysis

                </button>


            </div>


        </div>





        <!-- Purchase Order Period -->


        <div class="card shadow-sm mb-4">


            <div class="card-body">


                <h3>
                    📄 Purchase Order Period
                </h3>


                <p>
                    Generate Purchase Order report by period.
                </p>


                <button
                    class="btn btn-primary"
                    t-on-click="openPurchaseOrderPeriod">

                    Open Purchase Order Period

                </button>


            </div>


        </div>





        <!-- Incoming Order Period -->


        <div class="card shadow-sm">


            <div class="card-body">


                <h3>
                    📦 Incoming Order Period
                </h3>


                <p>
                    Generate Incoming Order report by period.
                </p>


                <button
                    class="btn btn-primary"
                    t-on-click="openIncomingOrderPeriod">

                    Open Incoming Order Period

                </button>


            </div>


        </div>



    </div>


</t>


</templates>