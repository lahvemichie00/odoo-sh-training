<?xml version="1.0" encoding="UTF-8"?>

<odoo>


    <!-- Purchase Analysis Graph View -->

    <record id="view_purchase_report_graph" model="ir.ui.view">

        <field name="name">purchase.report.graph</field>

        <field name="model">purchase.report</field>

        <field name="arch" type="xml">

            <graph string="Purchase Analysis" type="line">

                <field name="date_order" interval="day"/>

                <field name="untaxed_total" type="measure"/>

            </graph>

        </field>

    </record>

    <!-- Purchase Analysis Pivot View -->

    <record id="view_purchase_report_pivot" model="ir.ui.view">


        <field name="name">purchase.report.pivot</field>

        <field name="model">purchase.report</field>


        <field name="arch" type="xml">


            <pivot string="Purchase Analysis">


                <field name="category_id" type="row"/>


                <field name="nbr_lines" type="measure"/>


                <field name="qty_ordered" type="measure"/>


                <field name="untaxed_total" type="measure"/>


                <field name="price_total" type="measure"/>


            </pivot>


        </field>


    </record>

    <!-- Purchase Analysis Search -->


    <record id="view_purchase_report_search" model="ir.ui.view">


        <field name="name">purchase.report.search</field>


        <field name="model">purchase.report</field>


        <field name="arch" type="xml">


            <search string="Purchase Analysis">


                <field name="partner_id"/>

                <field name="product_id"/>

                <field name="category_id"/>

                <field name="date_order"/>



                <filter
                    string="Confirmed Orders"
                    name="confirmed"
                    domain="[('state','=','purchase')]"/>


                <group>


                    <filter
                        string="Vendor"
                        name="vendor"
                        context="{'group_by':'partner_id'}"/>


                    <filter
                        string="Product Category"
                        name="category"
                        context="{'group_by':'category_id'}"/>


                    <filter
                        string="Confirmation Date"
                        name="date"
                        context="{'group_by':'date_order'}"/>


                </group>


            </search>


        </field>


    </record>

    <!-- Purchase Analysis Action -->


    <record id="action_purchase_analysis" model="ir.actions.act_window">


        <field name="name">Purchase Analysis</field>


        <field name="res_model">purchase.report</field>


        <field name="view_mode">graph,pivot</field>


        <field name="search_view_id" ref="view_purchase_report_search"/>


    </record>

    <!-- Purchase Analysis Menu -->


    <menuitem
        id="menu_purchase_analysis"
        name="Purchase Analysis"
        parent="purchase.purchase_report_main"
        action="action_purchase_analysis"
        sequence="1"/>

</odoo>
