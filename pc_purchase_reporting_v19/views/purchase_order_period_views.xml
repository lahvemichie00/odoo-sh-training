<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_period_form" model="ir.ui.view">
        <field name="name">purchase.order.period.form</field>
        <field name="model">purchase.order.period</field>
        <field name="arch" type="xml">

            <form string="Purchase Order Period">

                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="po_status"/>
                        <field name="company_id"/>
                    </group>

                    <group>
                        <field name="end_date"/>
                    </group>
                </group>

                <footer>
                    <button
                        name="action_generate_excel"
                        type="object"
                        string="GENERATE EXCEL"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"/>
                </footer>

            </form>

        </field>
    </record>


    <record id="action_purchase_order_period" model="ir.actions.act_window">

        <field name="name">
            Purchase Order Period
        </field>

        <field name="res_model">
            purchase.order.period
        </field>

        <field name="view_mode">
            form
        </field>

        <field name="target">
            new
        </field>

    </record>


    <menuitem
        id="menu_purchase_order_period"
        name="Purchase Order Period"
        parent="purchase.purchase_report_main"
        action="action_purchase_order_period"
        sequence="20"/>

</odoo>
